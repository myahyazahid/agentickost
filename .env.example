APP_NAME="Agentic Kost"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agentickost
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=agentickost
AWS_SECRET_ACCESS_KEY=agentickost-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=agentickost
AWS_ENDPOINT=http://127.0.0.1:8333
AWS_USE_PATH_STYLE_ENDPOINT=true

# Backup database (docs/deployment.md, bagian Kesiapan produksi).
# Pakai bucket di lokasi terpisah dari penyimpanan berkas aplikasi.
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=

# Kunci HMAC nomor identitas penghuni, terpisah dari APP_KEY.
# Buat dengan: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
IDENTITY_HASH_KEY=

# Sakelar pengembangan. Isi false untuk mematikan pemeriksaan di laptop.
# Di APP_ENV=production sakelar ini diabaikan dan pemeriksaan selalu aktif.
# 2FA wajib untuk Owner, Akuntan, dan super admin.
AGENTICKOST_TWO_FACTOR_REQUIRED=true
# Kode OTP WhatsApp saat login portal penghuni. false: cukup nomor HP.
AGENTICKOST_PORTAL_OTP_REQUIRED=true
# Mode baca saja dan batas paket langganan. false: tidak ada batas.
AGENTICKOST_SUBSCRIPTION_ENFORCED=true

# Pengirim pesan WhatsApp. "log" menulis pesan ke storage/logs, tidak mengirim.
# Satu-satunya pilihan sampai penyedia WhatsApp diputuskan.
AGENTICKOST_WHATSAPP_DRIVER=log

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

VITE_APP_NAME="${APP_NAME}"
